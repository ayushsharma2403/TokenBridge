# Sample Production Environment Variables
# Copy to .env or paste directly into your Cloud Hosting Dashboard (Railway / Render / VPS)

APP_URL=https://your-domain-or-railway-url.app
ALLOWED_ORIGINS=https://your-domain-or-railway-url.app

# Database (either provide DATABASE_URL or individual DB_* credentials)
# DATABASE_URL=mysql://root:password@host:3306/tokenbridge
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=tokenbridge

# Security & Authentication
JWT_SECRET=generate_a_64_character_random_string_here

# AI Models (Optional defaults)
CLAUDE_MODEL=claude-3-5-haiku-20241022
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.6-flash

# Email OTP & Password Reset (Gmail SMTP)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_letter_app_password

# Google OAuth (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
